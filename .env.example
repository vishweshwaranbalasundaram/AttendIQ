# ---- Database: sqlite (zero setup, default) or mysql ----
ATTENDIQ_DB=sqlite
ATTENDIQ_SQLITE_PATH=attendiq.db

# MySQL (set ATTENDIQ_DB=mysql to use it)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=attendance_tracker

# ---- Rules ----
ATTENDIQ_THRESHOLD=75
ATTENDIQ_WARNING_BAND=80

# ---- Security (CHANGE THIS) ----
ATTENDIQ_SECRET=change-me-to-a-long-random-string

# ---- AI (optional; without a key the ChatAgent uses its offline rule-based mode) ----
ANTHROPIC_API_KEY=
ATTENDIQ_MODEL=claude-sonnet-5-5

# ---- Alerts (optional; without these, alerts are saved with status 'simulated') ----
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
